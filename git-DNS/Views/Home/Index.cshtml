@{
    ViewData["Title"] = "DNS Query — Learn how the internet finds websites";
}

<main class="app-shell">
    <nav class="topbar" aria-label="Primary navigation">
        <a class="brand" href="#top" aria-label="DNS Query home">
            <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
            <span>dns<span class="brand-accent">query</span></span>
        </a>
        <div class="topbar-links">
            <a href="#explore">Explore records</a>
            <a href="#how-it-works">How DNS works</a>
            <a class="github-link" href="https://github.com" target="_blank" rel="noreferrer">Open source <span aria-hidden="true">↗</span></a>
        </div>
    </nav>

    <section class="hero" id="top">
        <div class="eyebrow"><span class="pulse-dot"></span> The internet's address book</div>
        <h1>See what happens<br />when you <em>visit a website.</em></h1>
        <p class="hero-copy">DNS turns names like <strong>example.com</strong> into the IP addresses computers use to connect. Query a domain and unpack the answer, one record at a time.</p>

        <form class="query-form" id="query-form">
            <label class="sr-only" for="domain-input">Domain name</label>
            <span class="input-prefix" aria-hidden="true">https://</span>
            <input id="domain-input" name="domain" type="text" placeholder="Enter a domain, like example.com" autocomplete="url" spellcheck="false" value="example.com" />
            <button type="submit" class="query-button"><span>Look up domain</span><span aria-hidden="true">→</span></button>
        </form>
        <div class="query-meta"><span class="key-icon" aria-hidden="true">⌘</span> Press <kbd>Enter</kbd> to search <span class="meta-separator">·</span> <button type="button" class="example-link" data-example="github.com">Try github.com</button></div>
        <p class="form-error" id="form-error" role="alert" hidden></p>
    </section>

    <section class="results-section" id="results" aria-live="polite">
        <div class="results-heading">
            <div>
                <div class="section-label">Live lookup</div>
                <h2 id="results-title">DNS records for <span>example.com</span></h2>
            </div>
            <div class="lookup-status" id="lookup-status"><span class="status-dot"></span><span id="status-text">Ready to query</span></div>
        </div>
        <div class="record-grid" id="record-grid"></div>
        <div class="empty-state" id="empty-state" hidden>
            <div class="empty-icon">⌁</div>
            <h3>No records found</h3>
            <p>We couldn't find a record of that type for this domain. Try another lookup.</p>
        </div>
        <div class="loading-state" id="loading-state" hidden><span class="spinner"></span> Asking the DNS...</div>
    </section>

    <section class="explanation-section" id="how-it-works">
        <div class="section-intro">
            <div class="section-label">A quick field guide</div>
            <h2>Every record has a job.</h2>
            <p>DNS is a distributed system made of different record types. Together, they tell browsers where to go and mail servers what to do.</p>
        </div>
        <div class="record-guide" id="explore">
            <article class="guide-card guide-a"><div class="guide-icon">A</div><div><h3>A / AAAA <span>Address</span></h3><p>Points a domain to a server's IPv4 or IPv6 address—the final destination for a web request.</p></div></article>
            <article class="guide-card guide-cname"><div class="guide-icon">↗</div><div><h3>CNAME <span>Alias</span></h3><p>Creates an alias that points one domain to another, useful for services hosted elsewhere.</p></div></article>
            <article class="guide-card guide-mx"><div class="guide-icon">✉</div><div><h3>MX <span>Mail exchange</span></h3><p>Directs email to the servers responsible for receiving messages for a domain.</p></div></article>
            <article class="guide-card guide-ns"><div class="guide-icon">◎</div><div><h3>NS <span>Name server</span></h3><p>Delegates authority for a domain to the DNS servers that know its records.</p></div></article>
            <article class="guide-card guide-txt"><div class="guide-icon">T</div><div><h3>TXT <span>Text</span></h3><p>Stores text used for verification and security policies like SPF and site ownership.</p></div></article>
            <article class="guide-card guide-ttl"><div class="guide-icon">◷</div><div><h3>TTL <span>Time to live</span></h3><p>Sets how long a DNS response can be cached before a resolver asks again.</p></div></article>
        </div>
    </section>

    <footer class="app-footer"><span class="brand brand-small"><span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span><span>dns<span class="brand-accent">query</span></span></span><span>Built for the curious · Queries powered by <a href="https://www.cloudflare.com/learning/dns/what-is-dns/" target="_blank" rel="noreferrer">public DNS</a></span></footer>
</main>
